# The production onboarding flow does not need a .env.local.
# The developer creates and downloads a per-device JSON setup file from the
# Admin dashboard; the merchant installs it, then signs in using their account.
# These values are optional only for local development/migration from old clients.
POS_STORE_ID=YOUR_STORE_UUID
POS_STORE_NAME=My Retail Store
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Development-only: do not ship a static access token to a merchant.
# SUPABASE_ACCESS_TOKEN=YOUR_STORE_USER_ACCESS_TOKEN
